# Skopiuj do .env i uzupełnij lokalnie. Nie udostępniaj pliku .env ani katalogu .auth.
GITLAB_USERNAME=
GITLAB_PASSWORD=
# Osobne dane hurtownika — apiPassword z kolekcji Postmana, nie hasło GitLab.
HURT_EMAIL=
HURT_API_PASSWORD=
HURT_TESTS_TOKEN=
# Opcjonalna alternatywa dla logowania przeglądarkowego:
HURT_GATEWAY_COOKIE=
# Adres API dev hurtowni:
HURT_DEV_BASE_URL=https://ksiegarnia.gwodev.pl/api/v2
HURT_TEST_EMAIL=
HURT_TEST_API_PASSWORD=
HURT_TEST_TESTS_TOKEN=
HURT_TEST_GATEWAY_COOKIE=

SYLIUS_ADMIN_EMAIL=

SYLIUS_ADMIN_PASSWORD=

# Przeglądarka do sesji GitLab, konfiguracji CMS i odczytu phpMyAdmin:
BROWSER_CHANNEL=msedge
# Opcjonalne SELECT-y po finalizacji (bookshop2 i gwo_transfer przez phpMyAdmin dev):
HURT_VERIFY_DATABASE=false


# Drugie konto hurtownika dev: osobna tożsamość do regresji i izolacji koszyków.
HURT_SECOND_EMAIL=
HURT_SECOND_API_PASSWORD=
# Puste = wspólny HURT_TESTS_TOKEN (token środowiska, nie użytkownika).
HURT_SECOND_TESTS_TOKEN=
# Oczekiwane rabaty w procentach 0–100; wpisz także 0, jeśli brak rabatu.
HURT_SECOND_REBATE_CASH_ON_DELIVERY=
HURT_SECOND_REBATE_BANK_TRANSFER_1_DAY=
HURT_SECOND_REBATE_PAYMENT_TIMELY=
HURT_SECOND_REBATE_ADAMADA=

# Zwykły przelew bankowy drugiego konta (oczekiwany rabat):
HURT_SECOND_REBATE_BANK_TRANSFER=

# E-mail użytkownika wybieranego w panelu; wspólne HURT_API_PASSWORD, rabaty odczytywane z CMS:
HURT_CUSTOM_EMAIL=

# Osobne logowanie Moje GWO do kontroli podsumowania RETAIL (bez zapisu):
RETAIL_LOGIN_EMAIL=
RETAIL_LOGIN_PASSWORD=
