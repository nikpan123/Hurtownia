{
  "environment":"dev",
  "baseUrl":"https://ksiegarnia.gwodev.pl/api/v2",
  "enabled":true,
  "credentials":{"emailEnv":"HURT_EMAIL","passwordEnv":"HURT_API_PASSWORD","testsTokenEnv":"HURT_TESTS_TOKEN","cookieEnv":"HURT_GATEWAY_COOKIE"},
  "timeoutMs":30000,
  "outputDirectory":"raporty-api",
  "catalog":{
    "channels":["WHOLESALE","RETAIL","ACADEMY"],
    "maxPages":100,
    "maxProducts":1000,
    "pageSize":50,
    "fixtureFile":"config/catalog-fixtures.local.json",
    "strictInvalidParameters":true,
    "pollAttempts":10,
    "pollDelayMs":1500
  },
  "creation":{
    "adminEmailEnv":"SYLIUS_ADMIN_EMAIL",
    "adminPasswordEnv":"SYLIUS_ADMIN_PASSWORD",
    "priceMinor":5000,
    "prefix":"qa-catalog"
  }
}
